#!/bin/bash

input="$1"

if [[ -z "$input" ]]; then
    echo "Usage: tsvsymbol <file.tsv>"
    exit 1
fi

if [[ ! -f "$input" ]]; then
    echo "File not found: $input"
    exit 1
fi

output="${input%.tsv}_excel.tsv"

{
    printf '\xFF\xFE'
    iconv -f UTF-8 -t UTF-16LE "$input"
} > "$output"

echo "Created: $output"

open -a "Microsoft Excel" "$output"
